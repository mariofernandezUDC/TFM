/* Dashboard.uss · Dashboard de la planta virtual (D008, P4).
   Decisiones de estilo: guia/Encargo - Lanzador desde Unity.md, P4.
   Acentos: lima #D4F23C, cian #3EE6E0, ámbar #F5B731.
   Nunca blanco, rojo ni azul como acento: son los colores de las piezas.
   Letra mínima: 14 px. DashboardPlanta no deja bajar la escala de 12/14, así
   que en pantalla ningún texto queda por debajo de 12 px (D009). */

.raiz {
    flex-grow: 1;
    padding: 16px;
    color: rgb(242, 244, 245);
    font-size: 15px;
    -unity-font: url("project://database/Assets/Scripts/PlantaVirtual/UI/Fuentes/Outfit-Regular.ttf");
}

.texto-fuerte {
    -unity-font: url("project://database/Assets/Scripts/PlantaVirtual/UI/Fuentes/Outfit-SemiBold.ttf");
}

.texto-medio {
    -unity-font: url("project://database/Assets/Scripts/PlantaVirtual/UI/Fuentes/Outfit-Medium.ttf");
}

/* ── Panel translúcido: negro, borde fino claro, radio 16 px. Sin desenfoque. ──
   El proyecto está en espacio de color lineal y la UI se mezcla en lineal: un alfa
   de 0,85 oscurece a la vista como un negro al ~60 % mezclado en sRGB (la pieza
   que queda debajo se ve al ~40 % de su brillo). Con 0,6 se vería casi transparente. */

.panel {
    background-color: rgba(8, 9, 11, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 16px;
}

/* ── Barra superior ───────────────────────────────────────────────────────── */

.barra {
    flex-direction: row;
    align-items: center;
    height: 68px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 34px;
}

.barra-titulo {
    font-size: 20px;
    margin-left: 8px;
    margin-right: 24px;
}

.selector {
    flex-direction: row;
    align-items: center;
    width: 400px;
    height: 44px;
    padding-left: 4px;
    padding-right: 4px;
    border-radius: 22px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    background-color: rgba(255, 255, 255, 0.06);
}

.selector-boton {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 36px;
    margin: 0;
    padding-left: 14px;
    padding-right: 10px;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(242, 244, 245);
    font-size: 15px;
    -unity-text-align: middle-left;
    transition-duration: 0.15s;
}

.selector-boton:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.selector-texto {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    -unity-text-align: middle-left;
}

.icono {
    width: 14px;
    height: 14px;
    flex-shrink: 0;
}

.boton-icono {
    width: 36px;
    height: 36px;
    margin: 0 0 0 4px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.75);
    transition-duration: 0.15s;
}

.boton-icono:hover {
    background-color: rgba(255, 255, 255, 0.14);
    color: rgb(242, 244, 245);
}

.boton-icono .icono {
    width: 16px;
    height: 16px;
}

.pildora {
    height: 44px;
    margin: 0 0 0 10px;
    padding: 0 24px;
    border-width: 1px;
    border-radius: 22px;
    font-size: 16px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.boton-cargar {
    background-color: rgb(212, 242, 60);
    border-color: rgb(212, 242, 60);
    color: rgb(21, 23, 15);
}

.boton-cargar:hover {
    background-color: rgb(224, 247, 106);
    border-color: rgb(224, 247, 106);
}

.boton-parar {
    background-color: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.16);
    color: rgb(242, 244, 245);
}

.boton-parar:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.estado {
    flex-direction: row;
    align-items: center;
    height: 44px;
    margin-left: auto;
    padding: 0 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.06);
}

.estado-punto {
    width: 10px;
    height: 10px;
    margin-right: 10px;
    border-radius: 5px;
    background-color: rgb(138, 143, 152);
}

.estado-texto {
    font-size: 15px;
}

.estado--en-marcha .estado-punto {
    background-color: rgb(62, 230, 224);
}

.estado--error .estado-punto {
    background-color: rgb(245, 183, 49);
}

.estado--error .estado-texto {
    color: rgb(245, 183, 49);
}

/* ── Cuerpo: columna izquierda · hueco de la planta · columna derecha ─────── */

.cuerpo {
    flex-grow: 1;
    flex-direction: row;
    margin-top: 16px;
    margin-bottom: 16px;
}

.columna {
    width: 320px;
}

.columna-derecha {
    width: 340px;
}

.hueco {
    flex-grow: 1;
}

/* ── Tarjetas plegables ───────────────────────────────────────────────────── */

.tarjeta {
    padding: 14px 16px 16px 18px;
    margin-bottom: 16px;
}

.tarjeta-cabecera {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.tarjeta-titulo {
    font-size: 18px;
}

.boton-plegar {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.7);
    font-size: 17px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.boton-plegar:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.tarjeta-cuerpo {
    margin-top: 12px;
}

.tarjeta--plegada .tarjeta-cuerpo {
    display: none;
}

.marcador {
    color: rgba(255, 255, 255, 0.4);
    font-size: 14px;
}

/* ── Salida del programa (abajo) ──────────────────────────────────────────── */

/* Por defecto ~4 líneas; con «+» ~12. Las líneas del log de la librería van
   ocultas hasta que se pulsa «Ver detalle». */

.tarjeta-salida {
    padding-top: 10px;
    padding-bottom: 12px;
    margin-bottom: 0;
}

.tarjeta-salida .tarjeta-cuerpo {
    margin-top: 6px;
}

.salida-scroll {
    height: 80px;
    overflow: hidden;
}

.salida-scroll .unity-scroll-view__content-container {
    flex-shrink: 0;
}

.tarjeta-salida--ampliada .salida-scroll {
    height: 236px;
}

.cabecera-botones {
    flex-direction: row;
    align-items: center;
}

.boton-detalle {
    height: 28px;
    margin: 0 8px 0 0;
    padding: 0 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 14px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.75);
    font-size: 14px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.boton-detalle:hover {
    background-color: rgba(255, 255, 255, 0.14);
    color: rgb(242, 244, 245);
}

.tarjeta-salida--detalle .boton-detalle {
    border-color: rgba(212, 242, 60, 0.6);
    color: rgb(212, 242, 60);
}

.salida-linea {
    flex-shrink: 0;
    min-height: 20px;
    margin: 0;
    padding: 0;
    font-size: 14px;
    -unity-text-align: middle-left;
    color: rgba(255, 255, 255, 0.88);
    white-space: normal;
}

.salida-linea--aviso {
    color: rgb(212, 242, 60);
}

.salida-linea--error {
    color: rgb(240, 149, 149);
}

.salida-linea--detalle {
    display: none;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
}

.tarjeta-salida--detalle .salida-linea--detalle {
    display: flex;
}

/* ── Resultado y ciclo por pieza (P4c) ─────────────────────────────────────────
   Bien = lima, mal = ámbar, ciclo = cian. Nunca rojo ni azul (colores de las piezas). */

.resultado-cabeza {
    flex-direction: row;
    align-items: flex-end;
}

.resultado-porcentaje {
    font-size: 36px;
    color: rgb(242, 244, 245);
    margin-right: 10px;
}

.resultado-sub {
    flex-shrink: 1;
    margin-bottom: 7px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    white-space: normal;
}

.resultado-barra {
    height: 10px;
    margin: 10px 0 12px 0;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.10);
    overflow: hidden;
}

.resultado-barra-bien {
    height: 100%;
    width: 0;
    border-radius: 5px;
    background-color: rgb(212, 242, 60);
    transition-duration: 0.3s;
}

.resultado-cuentas {
    flex-direction: row;
    justify-content: space-between;
}

.cuenta {
    flex-grow: 1;
    flex-basis: 0;
}

.cuenta-valor {
    font-size: 22px;
    color: rgb(242, 244, 245);
}

.cuenta-nombre {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
}

.cuenta--bien .cuenta-valor {
    color: rgb(212, 242, 60);
}

.cuenta--mal .cuenta-valor {
    color: rgb(245, 183, 49);
}

.ciclo-barras {
    margin-top: 10px;
}

.ciclo-fila {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.ciclo-nombre {
    width: 56px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
}

.ciclo-pista {
    flex-grow: 1;
    height: 10px;
    margin: 0 10px;
    border-radius: 5px;
    background-color: rgba(255, 255, 255, 0.08);
}

.ciclo-barra {
    height: 100%;
    border-radius: 5px;
    background-color: rgb(62, 230, 224);
}

.ciclo-barra--mal {
    background-color: rgb(245, 183, 49);
}

.ciclo-tiempo {
    width: 44px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    -unity-text-align: middle-right;
}

/* ── Retos (P4c): Fácil = lima, Medio = cian, Avería = ámbar ───────────────── */

.reto {
    margin: 0 0 8px 0;
    padding: 9px 12px 10px 12px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-left-width: 4px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.05);
    -unity-text-align: upper-left;
    transition-duration: 0.12s;
}

.reto:hover {
    background-color: rgba(255, 255, 255, 0.11);
}

.reto-cabeza {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.reto-titulo {
    font-size: 15px;
    color: rgb(242, 244, 245);
}

.reto-chip {
    height: 20px;
    padding: 0 8px;
    border-radius: 10px;
    font-size: 14px;
    -unity-text-align: middle-center;
}

.reto-detalle {
    margin-top: 2px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.55);
    white-space: normal;
}

.reto--facil {
    border-left-color: rgb(212, 242, 60);
}

.reto--facil .reto-chip {
    color: rgb(212, 242, 60);
    background-color: rgba(212, 242, 60, 0.14);
}

.reto--medio {
    border-left-color: rgb(62, 230, 224);
}

.reto--medio .reto-chip {
    color: rgb(62, 230, 224);
    background-color: rgba(62, 230, 224, 0.14);
}

.reto--averia {
    border-left-color: rgb(245, 183, 49);
}

.reto--averia .reto-chip {
    color: rgb(245, 183, 49);
    background-color: rgba(245, 183, 49, 0.14);
}

/* Sin tocar el borde izquierdo, que lleva el color de la dificultad. */
.reto--elegido {
    border-top-color: rgba(255, 255, 255, 0.45);
    border-right-color: rgba(255, 255, 255, 0.45);
    border-bottom-color: rgba(255, 255, 255, 0.45);
    background-color: rgba(255, 255, 255, 0.10);
}

/* ── Sensores y salidas (P4b) ─────────────────────────────────────────────────
   Encendido = cian. Nunca blanco, rojo ni azul (colores de las piezas). */

.es-grupo {
    margin: 6px 0 4px 0;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
}

.es-fila {
    flex-direction: row;
    align-items: center;
    height: 24px;
}

.es-punto {
    width: 8px;
    height: 8px;
    margin-right: 10px;
    border-radius: 4px;
    background-color: rgba(255, 255, 255, 0.18);
}

.es-codigo {
    width: 30px;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
}

.es-nombre {
    flex-grow: 1;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
}

.es-valor {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    -unity-text-align: middle-right;
}

.es-fila.es--activa .es-punto {
    background-color: rgb(62, 230, 224);
}

.es-fila.es--activa .es-codigo,
.es-fila.es--activa .es-nombre,
.es-fila.es--activa .es-valor {
    color: rgb(62, 230, 224);
}

/* ── Etiquetas sobre la planta 3D ─────────────────────────────────────────── */

.capa-etiquetas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.etiqueta-sensor {
    position: absolute;
    translate: -50% -100%;
    height: 24px;
    padding: 0 9px;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.22);
    border-radius: 12px;
    background-color: rgba(8, 9, 11, 0.85);
    transition-duration: 0.12s;
}

.etiqueta-sensor-texto {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    -unity-text-align: middle-center;
    white-space: nowrap;
}

.etiqueta-sensor.es--activa {
    background-color: rgb(62, 230, 224);
    border-color: rgb(62, 230, 224);
}

.etiqueta-sensor.es--activa .etiqueta-sensor-texto {
    color: rgb(8, 9, 11);
}

/* ── Lista desplegable de programas ───────────────────────────────────────── */

.lista-programas {
    position: absolute;
    width: 400px;
    max-height: 440px;
    padding: 6px;
    background-color: rgba(24, 26, 30, 0.97);
}

.lista-programas--oculta {
    display: none;
}

.lista-item {
    height: 34px;
    margin: 0;
    padding: 0 12px;
    border-width: 0;
    border-radius: 10px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(242, 244, 245);
    font-size: 14px;
    -unity-text-align: middle-left;
    transition-duration: 0.1s;
}

.lista-item:hover {
    background-color: rgba(255, 255, 255, 0.08);
}

.lista-item--elegido {
    color: rgb(212, 242, 60);
}
